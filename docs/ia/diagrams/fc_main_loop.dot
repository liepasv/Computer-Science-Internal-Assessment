// Flowchart 1c: the quiz loop (session.js, ui.js)
digraph G {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.32, fontname="Liberation Sans"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="filled", fillcolor="#ffffff", color="#1f2937"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#1f2937"];
  begin [label="from Figure C10b", shape=box, style="rounded,filled", fillcolor="#e5e7eb"];
  show  [label="renderQuestion()"];
  ans   [label="user answers\n(click or key A–D)", shape=parallelogram, fillcolor="#e0f2fe"];
  ha    [label="handleAnswer()\n(Figure C12)"];
  nxt   [label="user presses Next\n(click, Enter or Space)", shape=parallelogram, fillcolor="#e0f2fe"];
  inc   [label="currentIndex ← currentIndex + 1"];
  more  [label="currentIndex <\nnumber of questions?", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  fin   [label="finishSession(): stopTimer() if enabled;\nsaveSessionRecord()"];
  res   [label="showResults()", shape=parallelogram, fillcolor="#e0f2fe"];
  stop  [label="End of session", shape=box, style="rounded,filled", fillcolor="#e5e7eb"];
  begin -> show -> ans -> ha -> nxt -> inc -> more;
  more -> show [label="yes"];
  more -> fin [label="no"];
  fin -> res -> stop;
}
