// Flowchart 2: parseCSV(text) and isValidQuestion(q) (csv.js)
digraph G {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.32, fontname="Liberation Sans"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="filled", fillcolor="#ffffff", color="#1f2937"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#1f2937"];
  start [label="parseCSV(text)", shape=box, style="rounded,filled", fillcolor="#e5e7eb"];
  norm  [label="replace \\r\\n and \\r with \\n;\nrows ← [ ], fields ← [ ], current ← \"\",\ninQuotes ← false, i ← 0"];
  loop  [label="i < length\nof text?", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  c     [label="char ← text[i]"];
  esc   [label="char is a quote mark, inQuotes\nand next char is a quote mark?", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  addq  [label="add one quote mark to current;\ni ← i + 1 (skip the second one)"];
  q     [label="char is a\nquote mark?", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  tog   [label="inQuotes ← not inQuotes"];
  comma [label="char = ',' and\nnot inQuotes?", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  endf  [label="add trim(current) to fields;\ncurrent ← \"\""];
  nl    [label="char = newline\nand not inQuotes?", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  endr  [label="add trim(current) to fields;\nadd fields to rows if any field\nis not empty; fields ← [ ]; current ← \"\""];
  add   [label="current ← current + char"];
  inc   [label="i ← i + 1"];
  last  [label="save the last field and row\nif the file has no final newline"];
  two   [label="fewer than 2 rows\n(no data rows)?", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  none  [label="return { questions: [ ], skipped: 0 }", shape=box, style="rounded,filled", fillcolor="#e5e7eb"];
  r     [label="take the next row after the header;\nbuild q {id, text, options[4],\ncorrect, difficulty, explanation, picture}"];
  valid [label="isValidQuestion(q)?\ntext not empty; correct 1–4;\ndifficulty 1–3; option[correct] not empty", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  keep  [label="add q to parsed"];
  skip  [label="skipped ← skipped + 1"];
  moreR [label="more rows?", shape=diamond, fillcolor="#fef3c7", fontsize=9];
  ret   [label="return { questions: parsed, skipped }", shape=box, style="rounded,filled", fillcolor="#e5e7eb"];

  start -> norm -> loop;
  loop -> c [label="yes"];
  loop -> last [label="no"];
  c -> esc;
  esc -> addq [label="yes"];
  esc -> q [label="no"];
  q -> tog [label="yes"];
  q -> comma [label="no"];
  comma -> endf [label="yes"];
  comma -> nl [label="no"];
  nl -> endr [label="yes"];
  nl -> add [label="no"];
  {addq tog endf endr add} -> inc;
  inc -> loop;
  last -> two;
  two -> none [label="yes"];
  two -> r [label="no"];
  r -> valid;
  valid -> keep [label="yes"];
  valid -> skip [label="no"];
  {keep skip} -> moreR;
  moreR -> r [label="yes"];
  moreR -> ret [label="no"];
}
