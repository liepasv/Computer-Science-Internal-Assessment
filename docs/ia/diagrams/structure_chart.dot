// Decomposition of the problem (Criterion B)
digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.12, ranksep=0.35, fontname="Liberation Sans"];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#374151", fontname="Liberation Sans", fontsize=10, width=1.6];
  edge  [arrowhead=none, color="#374151"];
  root [label="Driving Theory\nPractice application", fillcolor="#dbeafe", fontsize=12, width=2.2];
  q  [label="1. Question bank\nCfS 1, 10", fillcolor="#e0f2fe"];
  s  [label="2. Session logic\nCfS 2, 6, 8", fillcolor="#e0f2fe"];
  u  [label="3. Quiz interface\nCfS 3, 4, 5", fillcolor="#e0f2fe"];
  r  [label="4. Results\nCfS 5, 7", fillcolor="#e0f2fe"];
  h  [label="5. History & review\nCfS 9", fillcolor="#e0f2fe"];
  l  [label="6. Language\nUsability", fillcolor="#e0f2fe"];
  root -> {q s u r h l};
  node [fillcolor="#f9fafb", fontsize=9, width=1.5];
  q1 [label="Load built-in bank"]; q2 [label="Load own CSV\n+ images"]; q3 [label="Parse CSV"]; q4 [label="Validate rows"]; q5 [label="Report loaded /\nskipped"];
  s1 [label="Shuffle\n(Fisher–Yates)"]; s2 [label="Select up to 30"]; s3 [label="Reset counters"]; s4 [label="Optional timer"]; s5 [label="Next / end early"];
  u1 [label="Show question\n+ picture"]; u2 [label="Mouse / keyboard\nanswer"]; u3 [label="Weighted scoring"]; u4 [label="Feedback +\nexplanation"];
  r1 [label="Score and %"]; r2 [label="Correct / incorrect"]; r3 [label="Breakdown by\ndifficulty"]; r4 [label="Time taken"];
  h1 [label="Save session\nlocally"]; h2 [label="Profiles"]; h3 [label="Progress chart"]; h4 [label="Most-missed\nquestions"]; h5 [label="Practise my\nmistakes"];
  l1 [label="LT / EN interface"]; l2 [label="LT / EN bank\n(same ids)"];
  q -> q1 -> q2 -> q3 -> q4 -> q5;
  s -> s1 -> s2 -> s3 -> s4 -> s5;
  u -> u1 -> u2 -> u3 -> u4;
  r -> r1 -> r2 -> r3 -> r4;
  h -> h1 -> h2 -> h3 -> h4 -> h5;
  l -> l1 -> l2;
}
